@inject MouseDiagState State
@implements IDisposable

<div class="card">
    <div class="panel-head"><h3>Button Test</h3></div>
    <p class="muted">Press each mouse button over this panel - it lights up on press.</p>
    <div class="btn-grid"
         @onpointerdown="OnDown" @onpointerup="OnUp"
         @oncontextmenu:preventDefault="true" @oncontextmenu="NoOp">
        @foreach (var b in _buttons)
        {
            <div class="mbtn @(State.ButtonStates.GetValueOrDefault(b) ? "lit" : "")">@b</div>
        }
    </div>
</div>

@code {
    private readonly MouseButton[] _buttons = Enum.GetValues<MouseButton>();

    protected override void OnInitialized() => State.OnChange += StateHasChanged;
    public void Dispose() => State.OnChange -= StateHasChanged;

    private void OnDown(PointerEventArgs e) => State.SetButton(Map(e.Button), true);
    private void OnUp(PointerEventArgs e) => State.SetButton(Map(e.Button), false);
    private void NoOp() { }

    private static MouseButton Map(long button) => button switch
    {
        0 => MouseButton.Left,
        1 => MouseButton.Middle,
        2 => MouseButton.Right,
        3 => MouseButton.Back,
        4 => MouseButton.Forward,
        _ => MouseButton.Left,
    };
}
