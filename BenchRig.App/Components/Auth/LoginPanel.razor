@inject AuthService AuthSvc
@inject NavigationManager Nav

<div class="auth-card card">
    <h2>Welcome back</h2>
    <p class="muted">Sign in to submit tickets, post in the forum, and save reports.</p>

    <label>Email</label>
    <input class="input" type="email" @bind="_email" placeholder="you@example.com" />

    <label>Password</label>
    <input class="input" type="password" @bind="_password" @onkeydown="OnKey" placeholder="••••••••" />

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="validation-message">@_error</p>
    }

    <button class="btn btn-primary btn-block" disabled="@_busy" @onclick="SignIn">
        @(_busy ? "Signing in..." : "Sign in")
    </button>
    <div class="auth-or"><span>or</span></div>
    <button class="btn btn-block" disabled="@_busy" @onclick="Google">Continue with Google</button>

    <p class="auth-foot">No account? <a href="@AppRoutes.Register">Create one</a></p>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private string? _error;
    private bool _busy;

    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await SignIn(); }

    private async Task SignIn()
    {
        _error = null; _busy = true;
        try
        {
            await AuthSvc.SignInWithEmailAsync(_email, _password);
            Nav.NavigateTo(AppRoutes.Home);
        }
        catch (Exception ex) { _error = Friendly(ex); }
        finally { _busy = false; }
    }

    private async Task Google()
    {
        _error = null; _busy = true;
        try
        {
            await AuthSvc.SignInWithGoogleAsync();
            Nav.NavigateTo(AppRoutes.Home);
        }
        catch (Exception ex) { _error = Friendly(ex); }
        finally { _busy = false; }
    }

    private static string Friendly(Exception ex)
        => ex.Message.Contains("invalid", StringComparison.OrdinalIgnoreCase) || ex.Message.Contains("password", StringComparison.OrdinalIgnoreCase)
            ? "Invalid email or password."
            : "Sign-in failed. Please try again.";
}
