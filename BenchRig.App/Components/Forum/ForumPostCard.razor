<a class="post-card" href="@AppRoutes.ForumPostFor(Post.Id)">
    <div class="pc-head">
        <h3>@Post.Title</h3>
        <span class="pc-rating">★ @Post.AvgRating.ToString("0.0")</span>
    </div>
    <p class="pc-body">@Truncate(Post.Body)</p>
    <div class="pc-meta">
        <span>@Post.AuthorName</span>
        <span class="muted">@Post.CommentCount comments · @Post.CreatedAt.ToLocalTime().ToString("d")</span>
    </div>
    @if (Post.Tags.Count > 0)
    {
        <div class="pc-tags">
            @foreach (var t in Post.Tags)
            {
                <span class="badge">@t</span>
            }
        </div>
    }
</a>

@code {
    [Parameter, EditorRequired] public ForumPost Post { get; set; } = default!;

    private static string Truncate(string s) => s.Length > 160 ? s[..160] + "..." : s;
}
