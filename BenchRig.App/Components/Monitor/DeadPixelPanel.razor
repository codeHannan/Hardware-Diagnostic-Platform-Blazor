@inject IJsMonitorBridge Monitor
@implements IAsyncDisposable

<div class="card">
    <div class="panel-head"><h3>Dead Pixel / Uniformity</h3></div>
    <p class="muted">Fill the screen with a solid color and inspect for stuck or dead pixels. Click a swatch, then go fullscreen.</p>
    <div class="swatches">
        @foreach (var c in _colors)
        {
            <button class="swatch @(c == _current ? "sel" : "")" style="background:@c" @onclick="() => _current = c"></button>
        }
    </div>
    <button class="btn btn-primary" style="margin-top:1rem" @onclick="GoFull">Fullscreen test</button>
</div>

@if (_full)
{
    <div id="deadpixel-overlay" class="dp-overlay" style="background:@_current" @onclick="Exit"></div>
}

@code {
    private readonly string[] _colors = ["#000000", "#ffffff", "#ff0000", "#00ff00", "#0000ff", "#948979", "#DFD0B8"];
    private string _current = "#000000";
    private bool _full;

    private async Task GoFull()
    {
        _full = true;
        StateHasChanged();
        await Task.Yield();
        await Monitor.EnterFullscreenAsync("deadpixel-overlay");
    }

    private async Task Exit()
    {
        await Monitor.ExitFullscreenAsync();
        _full = false;
    }

    public async ValueTask DisposeAsync()
    {
        if (_full) { try { await Monitor.ExitFullscreenAsync(); } catch { /* circuit gone */ } }
    }
}
