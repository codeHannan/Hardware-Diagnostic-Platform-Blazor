@inject MonitorTestOrchestrator Orch
@inject MonitorDiagState State
@implements IDisposable

<div class="card">
    <div class="panel-head">
        <h3>Refresh Rate</h3>
        <button class="btn btn-primary" @onclick="Measure">Measure</button>
    </div>
    <div class="centered">
        @if (State.RefreshRate is { } r)
        {
            <div style="text-align:center">
                <div class="big">@r.MeasuredHz.ToString("F1")</div>
                <span class="muted">Hz (measured via requestAnimationFrame)</span>
            </div>
        }
        else
        {
            <span class="muted">Click Measure to sample your display's refresh rate.</span>
        }
    </div>
</div>

@code {
    protected override void OnInitialized() => State.OnChange += StateHasChanged;
    public void Dispose() => State.OnChange -= StateHasChanged;

    private async Task Measure() => await Orch.MeasureRefreshRateAsync();
}
