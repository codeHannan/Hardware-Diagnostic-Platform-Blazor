@inject KeyboardTestOrchestrator Orch
@inject KeyboardDiagState State
@implements IAsyncDisposable

<div class="card">
    <div class="panel-head">
        <h3>Key Registration</h3>
        @if (!_active)
        {
            <button class="btn btn-primary" @onclick="Start">Start capture</button>
        }
        else
        {
            <button class="btn" @onclick="Stop">Stop</button>
        }
    </div>
    <p class="muted">Every key you press lights up. Stop to analyse chatter &amp; rollover.</p>

    <div class="keyboard">
        @foreach (var row in _rows)
        {
            <div class="krow">
                @foreach (var key in row)
                {
                    <span class="key @(State.PressedKeys.Contains(key.Code) ? "down" : "")" style="flex:@key.W">@key.Label</span>
                }
            </div>
        }
    </div>

    @if (State.Chatter.Count > 0)
    {
        <p class="badge badge-bad">Chatter detected on @string.Join(", ", State.Chatter.Select(c => c.Code))</p>
    }
    @if (State.Rollover is { } r)
    {
        <p class="muted">Max simultaneous keys (NKRO): <b class="mono">@r.MaxSimultaneousKeys</b></p>
    }
</div>

@code {
    private bool _active;
    private record K(string Code, string Label, double W = 1);

    private readonly K[][] _rows =
    [
        [ new("Escape","Esc"), new("Digit1","1"), new("Digit2","2"), new("Digit3","3"), new("Digit4","4"), new("Digit5","5"), new("Digit6","6"), new("Digit7","7"), new("Digit8","8"), new("Digit9","9"), new("Digit0","0"), new("Backspace","Bksp",2) ],
        [ new("Tab","Tab",1.5), new("KeyQ","Q"), new("KeyW","W"), new("KeyE","E"), new("KeyR","R"), new("KeyT","T"), new("KeyY","Y"), new("KeyU","U"), new("KeyI","I"), new("KeyO","O"), new("KeyP","P") ],
        [ new("CapsLock","Caps",1.8), new("KeyA","A"), new("KeyS","S"), new("KeyD","D"), new("KeyF","F"), new("KeyG","G"), new("KeyH","H"), new("KeyJ","J"), new("KeyK","K"), new("KeyL","L"), new("Enter","Enter",2) ],
        [ new("ShiftLeft","Shift",2.3), new("KeyZ","Z"), new("KeyX","X"), new("KeyC","C"), new("KeyV","V"), new("KeyB","B"), new("KeyN","N"), new("KeyM","M"), new("ShiftRight","Shift",2.3) ],
        [ new("ControlLeft","Ctrl",1.5), new("AltLeft","Alt",1.3), new("Space","Space",7), new("AltRight","Alt",1.3), new("ControlRight","Ctrl",1.5) ],
    ];

    protected override void OnInitialized() => State.OnChange += StateHasChanged;

    private async Task Start() { _active = true; await Orch.StartCaptureAsync(); }
    private async Task Stop() { _active = false; await Orch.StopCaptureAsync(); }

    public async ValueTask DisposeAsync()
    {
        State.OnChange -= StateHasChanged;
        if (_active) { try { await Orch.StopCaptureAsync(); } catch { /* circuit gone */ } }
    }
}
