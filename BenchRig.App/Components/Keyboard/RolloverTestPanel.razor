<div class="card">
    <div class="panel-head">
        <h3>Key Rollover (NKRO)</h3>
        <button class="btn btn-ghost" @onclick="Reset">Reset</button>
    </div>

    <div class="kbd-focusbar @(_focused ? "active" : "")">
        <span><span class="kbd-dot"></span> @(_focused ? "Hold as many keys as you can at once" : "Click below to start")</span>
        <span class="muted">peak @_max keys</span>
    </div>

    <div class="kbd-capture click-pad" tabindex="0" @ref="_el" style="min-height:200px"
         @onkeydown="OnDown" @onkeyup="OnUp" @onkeydown:preventDefault="true"
         @onfocus="() => _focused = true" @onblur="() => _focused = false" @onclick="Focus">
        <div>
            <div class="pad-big">@_held.Count</div>
            <div class="pad-sub">keys held right now · max @_max</div>
        </div>
    </div>

    <div class="chip-list">
        @foreach (var k in _held)
        {
            <span class="keychip">@Friendly(k)</span>
        }
    </div>

    <div class="result-grid">
        <MetricCard Label="Currently held" Value="@_held.Count.ToString()" />
        <MetricCard Label="Max simultaneous" Value="@_max.ToString()" />
        <MetricCard Label="Rollover" Value="@Rating" />
    </div>
    <p class="muted" style="margin-top:.6rem">Press more and more keys together. Membrane boards usually cap at 3–6 keys (with ghosting); a true NKRO board registers every key you hold.</p>
</div>

@code {
    private ElementReference _el;
    private bool _focused, _autofocused;
    private readonly HashSet<string> _held = new();
    private int _max;

    private string Rating => _max >= 10 ? "Excellent (NKRO-class)" : _max >= 6 ? "6KRO+" : _max >= 3 ? "Limited (3-key)" : "—";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    { if (firstRender && !_autofocused) { _autofocused = true; try { await _el.FocusAsync(); } catch { } } }
    private async Task Focus() { try { await _el.FocusAsync(); } catch { } }

    private void OnDown(KeyboardEventArgs e)
    {
        if (string.IsNullOrEmpty(e.Code)) return;
        _held.Add(e.Code);
        if (_held.Count > _max) _max = _held.Count;
    }

    private void OnUp(KeyboardEventArgs e) => _held.Remove(e.Code);

    private static string Friendly(string code)
        => code.StartsWith("Key") ? code[3..] : code.StartsWith("Digit") ? code[5..] : code;

    private void Reset() { _held.Clear(); _max = 0; }
}
